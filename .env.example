# Example environment variables for the backend. This file is documentation;
# .NET does not load it automatically. Set them in your shell or use User Secrets.
AzureDevOps__Organization=your-organization
AzureDevOps__Pat=your-read-only-pat

# Optional Summary CLI adapter. Point to a trusted executable that reads one
# JSON request from stdin and writes one JSON response to stdout.
# Ai__Summary__Executable=C:\path\to\summary-adapter.exe
# Ai__Summary__Arguments__0=--your-adapter-option
# Ai__Summary__Model=your-model-id
# Ai__Summary__TimeoutSeconds=120
